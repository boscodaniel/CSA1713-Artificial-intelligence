import random

class VacuumCleaner:
    def __init__(self):
        # Environment: two rooms A and B
        self.rooms = {"A": "dirty", "B": "dirty"}
        self.location = "A"  # start in room A
    
    def perceive(self):
        # Sense the state of the current room
        return self.rooms[self.location]
    
    def suck(self):
        # Clean the current room
        print(f"Vacuum at {self.location}: Suck dirt")
        self.rooms[self.location] = "clean"
    
    def move(self):
        # Move to the other room
        new_location = "B" if self.location == "A" else "A"
        print(f"Vacuum moves from {self.location} to {new_location}")
        self.location = new_location
    
    def run(self, steps=10):
        for step in range(steps):
            print(f"\nStep {step+1}:")
            percept = self.perceive()
            
            if percept == "dirty":
                self.suck()
            else:
                self.move()
            
            # Randomly make rooms dirty again (to simulate environment)
            if random.random() < 0.3:
                dirty_room = random.choice(["A", "B"])
                self.rooms[dirty_room] = "dirty"
                print(f"Environment: Room {dirty_room} became dirty again")

# Run the simulation
vacuum = VacuumCleaner()
vacuum.run(steps=10)
