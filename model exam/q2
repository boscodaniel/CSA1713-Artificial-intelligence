
import random

weights = [2, 3, 4, 5]
profits = [3, 4, 5, 6]
capacity = 8

def fitness(chromosome):
    weight = sum(
        chromosome[i] * weights[i]
        for i in range(len(weights))
    )
    profit = sum(
        chromosome[i] * profits[i]
        for i in range(len(profits))
    )
    return profit if weight <= capacity else 0

population = [
    [random.randint(0, 1) for _ in weights]
    for _ in range(10)
]

for generation in range(50):
    population.sort(key=fitness, reverse=True)
    new_population = population[:2]

    while len(new_population) < 10:
        p1, p2 = random.sample(population[:5], 2)
        point = random.randint(1, len(weights) - 1)

        child = p1[:point] + p2[point:]

        if random.random() < 0.2:
            i = random.randint(0, len(weights) - 1)
            child[i] = 1 - child[i]

        new_population.append(child)

    population = new_population

best = max(population, key=fitness)
selected = [i + 1 for i in range(len(best)) if best[i]]

print("Selected items:", selected)
print("Maximum fitness value:", fitness(best))
