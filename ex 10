import heapq

class Node:
    def __init__(self, name, g=0, h=0, parent=None):
        self.name = name
        self.g = g  # cost from start
        self.h = h  # heuristic estimate to goal
        self.f = g + h  # total cost
        self.parent = parent
    
    def __lt__(self, other):
        return self.f < other.f

def astar(graph, heuristics, start, goal):
    open_list = []
    closed_set = set()
    
    start_node = Node(start, g=0, h=heuristics[start])
    heapq.heappush(open_list, start_node)
    
    while open_list:
        current = heapq.heappop(open_list)
        
        if current.name == goal:
            # Reconstruct path
            path = []
            while current:
                path.append(current.name)
                current = current.parent
            return path[::-1]
        
        closed_set.add(current.name)
        
        for neighbor, cost in graph[current.name].items():
            if neighbor in closed_set:
                continue
            
            g = current.g + cost
            h = heuristics[neighbor]
            neighbor_node = Node(neighbor, g, h, current)
            
            # Check if neighbor already in open_list with lower f
            skip = False
            for node in open_list:
                if node.name == neighbor and node.f <= neighbor_node.f:
                    skip = True
                    break
            if not skip:
                heapq.heappush(open_list, neighbor_node)
    
    return None

