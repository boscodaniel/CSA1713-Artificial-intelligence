best_first(Start, Goal, Path) :-
    search([Start], Goal, [], ReversePath),
    reverse(ReversePath, Path).

search([Goal | _], Goal, Visited, [Goal | Visited]).
search([Current | Rest], Goal, Visited, Path) :-
    findall(H-Next,
            (edge(Current, Next), \+ member(Next, Visited)),
            Children),
    append(Rest, Children, OpenNodes),
    sort(OpenNodes, Sorted),
    remove_heuristic(Sorted, OrderedNodes),
    search(OrderedNodes, Goal, [Current | Visited], Path).

remove_heuristic([], []).
remove_heuristic([_-Node | Rest], [Node | Nodes]) :-
    remove_heuristic(Rest, Nodes).
